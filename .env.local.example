# Supabase — récupérer ces valeurs dans : Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_ANON_KEY

# Anthropic — NE JAMAIS exposer côté client, utilisé uniquement dans /api/ai
ANTHROPIC_API_KEY=sk-ant-VOTRE_CLE_API

# URL du site (pour les redirections auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notification WhatsApp à chaque inscription au tableau de bord gratuit (/api/free-dashboard)
# Activation : https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=+33600000000
CALLMEBOT_APIKEY=VOTRE_CLE_CALLMEBOT
